# Variables for deploy/uirapuru/compose.yaml. Point Uirapuru's variable
# discovery at this file. Never put real values here.

# Image to run, published by .github/workflows/publish-image.yml. @plain @required
PUXIRI_IMAGE=ghcr.io/OWNER/puxiri:0.1.0

# Public HTTPS origin served by the Uirapuru route. @plain @required
PUXIRI_BROWSER_ORIGIN=https://tracker.example.com

# Base64 of the 32-byte master key, kept in Ciphera so it survives the server. @secure @required
PUXIRI_MASTER_KEY_BASE64=

# Seconds between automatic captures; 0 disables. @plain
PUXIRI_REPLICATION_INTERVAL_SECONDS=300

# Hours before a new generation starts from a fresh snapshot. @plain
PUXIRI_REPLICATION_GENERATION_HOURS=24

# Generations kept at the S3 destination. @plain
PUXIRI_REPLICATION_RETAIN_GENERATIONS=7

# S3-compatible bucket; empty keeps replication local only. @plain
PUXIRI_REPLICATION_S3_BUCKET=

# Key prefix reserved for this installation. @plain
PUXIRI_REPLICATION_S3_PREFIX=puxiri

# @plain
PUXIRI_REPLICATION_S3_REGION=us-east-1

# Endpoint URL for a provider other than AWS. @plain
PUXIRI_REPLICATION_S3_ENDPOINT=

# @plain
PUXIRI_REPLICATION_S3_PATH_STYLE=false

# @secure
PUXIRI_REPLICATION_S3_ACCESS_KEY_ID=

# @secure
PUXIRI_REPLICATION_S3_SECRET_ACCESS_KEY=
