# Copy to .env next to compose.yaml. .env is ignored by git.

# Public HTTPS origin your front end serves (required).
PUXIRI_BROWSER_ORIGIN=https://tracker.example.com
# Base64 of the 32-byte master key. Empty keeps the key file in the data volume.
# Generate with `openssl rand -base64 32`; keep it in your secret manager.
PUXIRI_MASTER_KEY_BASE64=
# Host address and port to publish. Keep loopback when the front end is on this host.
PUXIRI_PUBLISH=127.0.0.1:3000
# Checkout of sqlite-replication used at build time.
SQLITE_REPLICATION_DIR=../sqlite-replication

# Automatic capture (0 disables), new generation age, and generations kept in S3.
PUXIRI_REPLICATION_INTERVAL_SECONDS=300
PUXIRI_REPLICATION_GENERATION_HOURS=24
PUXIRI_REPLICATION_RETAIN_GENERATIONS=7

# S3-compatible destination. Leave the bucket empty to keep replication local only.
PUXIRI_REPLICATION_S3_BUCKET=
PUXIRI_REPLICATION_S3_PREFIX=puxiri
PUXIRI_REPLICATION_S3_REGION=us-east-1
PUXIRI_REPLICATION_S3_ENDPOINT=
PUXIRI_REPLICATION_S3_PATH_STYLE=false
PUXIRI_REPLICATION_S3_ACCESS_KEY_ID=
PUXIRI_REPLICATION_S3_SECRET_ACCESS_KEY=
